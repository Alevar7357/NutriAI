    {
      "parameters": {
        "jsCode": "// ======================================================\n// NODO: Contar errores pendientes\n// OBJETIVO:\n// Contar únicamente los registros de logs_errores\n// cuyo estado sea \"Pendiente\".\n// Se vuelve a validar el estado aunque Airtable tenga filtro,\n// para evitar que un registro Ignorado o Resuelto afecte el KPI.\n// ======================================================\n\n\n// Obtiene todos los registros recibidos desde Airtable.\nconst errores = $input.all();\n\n\n// Filtra únicamente los errores cuyo estado sea \"Pendiente\".\nconst erroresPendientes = errores.filter(item =>\n  item.json.fields?.estado === 'Pendiente'\n);\n\n\n// Devuelve un único item con el KPI de errores pendientes.\nreturn [\n  {\n    json: {\n      errores_pendientes: erroresPendientes.length\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        304
      ],
      "id": "175b4edf-05ae-4004-b29c-9ad40c470415",
      "name": "Contar errores pendientes"
    },
    {
      "parameters": {
        "jsCode": "// ======================================================\n// NODO: Consolidar KPIs dashboard\n// OBJETIVO:\n// Reunir en un único JSON todos los indicadores\n// calculados previamente en el workflow W3.\n// ======================================================\n\n\n// Obtiene la cantidad total de usuarios registrados\n// calculada en el nodo \"Contar Usuarios\".\nconst usuariosRegistrados =\n  $('Contar Usuarios').first().json.usuarios_registrados;\n\n\n// Obtiene los indicadores relacionados con las comidas\n// calculados en el nodo \"Calcular KPIs de comidas\".\nconst comidasRegistradas =\n  $('Calcular KPIs de comidas').first().json.comidas_registradas;\n\nconst comidasProcesadas =\n  $('Calcular KPIs de comidas').first().json.comidas_procesadas;\n\nconst comidasConError =\n  $('Calcular KPIs de comidas').first().json.comidas_con_error;\n\n\n// Obtiene la cantidad de errores que actualmente\n// permanecen en estado \"Pendiente\".\nconst erroresPendientes =\n  $('Contar errores pendientes').first().json.errores_pendientes;\n\n\n// Devuelve un único item con todos los KPIs.\n// Este resultado se utilizará para actualizar\n// el registro NutriAI de la tabla dashboard_control.\nreturn [\n  {\n    json: {\n      usuarios_registrados: usuariosRegistrados,\n      comidas_registradas: comidasRegistradas,\n      comidas_procesadas: comidasProcesadas,\n      comidas_con_error: comidasConError,\n      errores_pendientes: erroresPendientes\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
