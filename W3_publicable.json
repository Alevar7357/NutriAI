    {
      "parameters": {
        "jsCode": "// ======================================================\n// NODO: Contar usuarios\n// OBJETIVO:\n// Contar la cantidad total de perfiles de usuario\n// recuperados desde Airtable.\n// ======================================================\n\n\n// Obtiene todos los perfiles encontrados por\n// el nodo \"Buscar usuarios\".\nconst usuarios = $input.all();\n\n\n// Devuelve un único item con la cantidad total\n// de usuarios registrados.\nreturn [\n  {\n    json: {\n      usuarios_registrados: usuarios.length\n    }\n  }\n];"
