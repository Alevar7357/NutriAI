    {
      "parameters": {
        "jsCode": "// ======================================================\n// NODO: Calcular KPIs de comidas\n// OBJETIVO:\n// Analizar todas las comidas recuperadas desde Airtable\n// y calcular los indicadores principales del dashboard.\n// ======================================================\n\n\n// Obtiene todos los registros de comidas que llegan\n// desde el nodo \"Buscar comidas dashboard\".\nconst comidas = $input.all();\n\n\n// Cuenta la cantidad total de comidas registradas.\nconst comidasRegistradas = comidas.length;\n\n\n// Cuenta únicamente las comidas cuyo estado de\n// procesamiento sea \"Procesada\".\nconst comidasProcesadas = comidas.filter(item =>\n  item.json.fields?.estado_procesamiento === 'Procesada'\n).length;\n\n\n// Cuenta únicamente las comidas cuyo estado de\n// procesamiento sea \"Error\".\nconst comidasConError = comidas.filter(item =>\n  item.json.fields?.estado_procesamiento === 'Error'\n).length;\n\n\n// Devuelve un único item con los KPIs calculados.\n// Estos valores serán utilizados posteriormente para\n// actualizar la tabla \"dashboard_control\" en Airtable.\nreturn [\n  {\n    json: {\n      comidas_registradas: comidasRegistradas,\n      comidas_procesadas: comidasProcesadas,\n      comidas_con_error: comidasConError\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
